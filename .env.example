# Local-only AI analysis companion settings.
# Keep this file blank of real credentials. Do not use NEXT_PUBLIC_ for secrets.
# Choose exactly one provider. There is no automatic fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# The previous gemini-2.5-flash-lite setting is rejected for new users by
# generateContent in the currently tested account. Confirm availability first.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional retained OpenAI adapter. It is used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional local ports. The runner also accepts these as command-line env vars.
AI_PM_RADAR_APP_PORT=3000
AI_PM_RADAR_FETCH_PORT=4310
# Protected mobile origin. Copy values to .env.local; never commit real values.
AI_PM_RADAR_PRODUCTION_PORT=4320
AI_PM_RADAR_PUBLIC_ORIGIN=https://radar.lamlab.cc
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAIL=
# Absolute path outside this repo. The file contains the remote Tunnel token and
# must be chmod 600. Do not put the token itself in .env.local.
CLOUDFLARE_TUNNEL_TOKEN_FILE=
# Optional gitignored local runtime directory for background research state.
# AI_PM_RADAR_RUNTIME_DIR=/absolute/path/to/ai-pm-radar-runtime
